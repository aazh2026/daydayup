{
  "name": "daydayup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:server": "npm run dev --workspace=@daydayup/server",
    "start:web": "npm run dev --workspace=@daydayup/web",
    "dev": "node scripts/start.mjs",
    "dev:server": "npm run dev --workspace=@daydayup/server",
    "dev:web": "npm run dev --workspace=@daydayup/web",
    "serve": "npm run start --workspace=@daydayup/server",
    "build": "npm run build --workspace=@daydayup/web",
    "preview": "npm run preview --workspace=@daydayup/web",
    "clean": "rm -rf web/dist packages/server/dist",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test --workspace=@daydayup/server",
    "test:web": "npm run test --workspace=@daydayup/web",
    "test:e2e": "node tests/e2e/teacher-dashboard.mjs",
    "test:e2e:gap": "node tests/e2e/gap-user-paths.mjs",
    "seed": "npm run seed --workspace=@daydayup/server",
    "backup": "npm run backup --workspace=@daydayup/server",
    "restore": "npm run restore --workspace=@daydayup/server",
    "cleanup": "npm run cleanup --workspace=@daydayup/server"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
