# ============================================================
# 智学中枢 · 环境变量
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---- AI 能力（必需，否则 AI 功能不可用）----
# Gemini API Key —— 试卷诊断、AI 教练、出题、评测都依赖它
# 获取地址：https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ---- 认证 ----
# 生产环境必须配置（随机 32 字节以上）：openssl rand -hex 32
#
# 未配置时进入「开发模式」：
#   - 不要求登录，直接进入应用
#   - 内置演示学生凭证：学生 PIN 1234
#   - 凭证存于 packages/server/data/db/credentials.json
#
# 配置后进入「生产模式」：
#   - 强制登录（前端显示登录页）
#   - 家长为只读角色、老师可访问全部学生
AUTH_SECRET=""

# 显式开关强制认证（不设置时：配置了 AUTH_SECRET 即自动启用）
# AUTH_REQUIRED="true"

# ---- 服务 ----
# 后端监听端口
PORT="3000"
# 后端监听地址
HOST="0.0.0.0"
# 日志级别：debug / info / warn / error
LOG_LEVEL="info"
# 允许跨域的前端来源（逗号分隔）。前后端同源部署时可留空
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---- 存储 ----
# 数据目录（默认 packages/server/data）
# DATA_DIR="./packages/server/data"
# 备份目录（默认 packages/server/backups）
# BACKUP_DIR="./packages/server/backups"

# ---- 安全与成本护栏 ----
# AI 每日调用上限（按账号计数，0 = 不限制）
DAILY_TOKEN_QUOTA="0"
# 全局限流：每分钟每用户最大请求数
RATE_LIMIT_PER_MINUTE="120"
# AI 端点限流：每分钟每用户最大请求数
RATE_LIMIT_AI_PER_MINUTE="10"

# ---- 后台任务 ----
# 并发任务数
JOB_CONCURRENCY="2"
# 单任务超时（毫秒）
JOB_TIMEOUT_MS="600000"

# ---- 数据保留期（天）----
RETENTION_EVENT_LOG_DAYS="180"
RETENTION_ATTEMPT_DAYS="365"
RETENTION_JOB_DAYS="30"
RETENTION_UPLOAD_DAYS="180"
RETENTION_AUDIT_DAYS="730"

# ---- 前端（构建时注入）----
# 前端 API 基础路径。留空表示同源（由 Vite proxy 或反向代理转发）
# VITE_API_BASE=""
# 开发期 Vite proxy 目标
# VITE_API_PROXY="http://localhost:3000"

# ---- 生产部署（可选）----
# 设置后由后端一并托管前端产物（单容器部署）
# STATIC_DIR="./web/dist"
